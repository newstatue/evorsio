{
  "name": "evorsio",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "bun --filter @evorsio/web dev",
    "dev:server": "bun --filter @evorsio/server dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build": "bun --filter @evorsio/web build",
    "prod": "bun --filter @evorsio/server prod",
    "db:migrate": "bun --filter @evorsio/server db:migrate:prod"
  },
  "devDependencies": {
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1"
  }
}
